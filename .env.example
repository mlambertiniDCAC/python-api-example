# Copiar a .env y ajustar. Nunca commitear .env.
API_PORT=8000
WEB_PORT=3000
# Ruta al repo del front (node-front-example).
FRONT_PATH=../node-front-example
# Orígenes del front habilitados por CORS (JSON).
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Define qué es "hoy" para los menús del día.
TZ=America/Argentina/Buenos_Aires
MYSQL_HOST_PORT=3310

MYSQL_DATABASE=menu
MYSQL_USER=menu
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin12345
